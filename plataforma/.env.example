# =============================================================================
# CargoFlow — variáveis de ambiente
# Copiar para .env.local e preencher. NUNCA versionar o .env.local.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Obter em: Supabase → o seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço — ignora Row Level Security.
# USAR APENAS no servidor (Edge Functions, tarefas agendadas). Nunca no browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Aplicação ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CargoFlow

# --- Mapas --------------------------------------------------------------------
# 'osm' (OpenStreetMap, sem custo) ou 'google'
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Fase 2: pagamentos -------------------------------------------------------
# MULTICAIXA_MERCHANT_ID=
# MULTICAIXA_API_KEY=

# --- Fase 2: notificações -----------------------------------------------------
# RESEND_API_KEY=
# SMS_GATEWAY_KEY=
